# Copy to .env or run: bash scripts/configure_secrets.sh
# Never commit the real key.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-32B
HF_INFERENCE_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MIN_INTERVAL_SECONDS=15

# DeepSeek qua endpoint tương thích OpenAI. Khi chọn provider=deepseek mà có sẵn
# GROQ_API_KEY thì Groq tự động thành fallback cho lỗi transport.
# DEEPSEEK_MODEL bắt buộc, không có giá trị mặc định: liệt kê tên hợp lệ bằng
#   python scripts/smoke_llm.py --list-models
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MIN_INTERVAL_SECONDS=0
DEEPSEEK_TIMEOUT_SECONDS=60
