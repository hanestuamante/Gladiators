{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "accuracy-benchmark-case.v1",
  "title": "Accuracy benchmark case v1",
  "type": "object",
  "required": [
    "id", "split", "language", "category", "paraphrase_group",
    "answerability", "expected_action", "accepted_actions",
    "expected_facts", "annotation_status",
    "author_read_source_code_before_seal"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^acc-v1-[0-9]{4}$"},
    "split": {"enum": ["dev", "holdout"]},
    "language": {"enum": ["vi", "vi_no_diacritic", "id", "en", "mixed"]},
    "category": {"type": "string", "minLength": 1},
    "question": {"type": ["string", "null"]},
    "turns": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["question", "expected_action"],
        "properties": {
          "question": {"type": "string"},
          "expected_action": {"enum": ["allow", "clarify", "abstain"]},
          "scored": {"type": "boolean"}
        }
      }
    },
    "paraphrase_group": {"type": "string", "minLength": 1},
    "entity_text": {"type": ["string", "null"]},
    "country": {"enum": ["vn", "id", null]},
    "answerability": {
      "enum": ["directly_answerable", "needs_clarification", "unanswerable"]
    },
    "expected_action": {"enum": ["allow", "clarify", "abstain"]},
    "accepted_actions": {
      "type": "array", "minItems": 1,
      "items": {"enum": ["allow", "clarify", "abstain"]}
    },
    "expected_clarification_slots": {"type": "array", "items": {"type": "string"}},
    "expected_refusal_reason_class": {"type": ["string", "null"]},
    "expected_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric", "value", "value_type", "unit", "country",
          "date_start", "date_end", "grain", "tolerance"
        ],
        "properties": {
          "metric": {"type": "string"},
          "oracle_fact_key": {"type": "string"},
          "value": {},
          "value_type": {"enum": ["integer", "decimal", "string", "boolean"]},
          "unit": {"type": ["string", "null"]},
          "country": {"enum": ["vn", "id", null]},
          "date_start": {"type": "string", "pattern": "^2026-07-0[1-3]$"},
          "date_end": {"type": "string", "pattern": "^2026-07-0[1-3]$"},
          "grain": {"type": "string"},
          "group": {"type": ["string", "null"]},
          "filters": {"type": "array", "items": {"type": "string"}},
          "tolerance": {
            "type": "object",
            "required": ["kind", "value"],
            "properties": {
              "kind": {"enum": ["exact", "absolute", "relative"]},
              "value": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "forbidden_values": {"type": "array", "items": {"type": "number"}},
    "oracle": {
      "type": ["object", "null"],
      "required": ["oracle_id", "params", "artifact_hash", "reproduction_ref"],
      "properties": {
        "oracle_id": {"type": "string"},
        "params": {"type": "object"},
        "artifact_hash": {"type": "string"},
        "reproduction_ref": {"type": "string"}
      }
    },
    "annotation_status": {
      "enum": ["adjudicated", "pending_independent_review"]
    },
    "author_read_source_code_before_seal": {"type": "boolean"},
    "tags": {"type": "array", "items": {"type": "string"}}
  }
}
